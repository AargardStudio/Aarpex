# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Used server-side for generating Stripe Invoices, Customers, and Payment Sessions
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY: Optional Stripe publishable key for client-side checkout
STRIPE_PUBLISHABLE_KEY=

# SUPABASE CREDENTIALS (for persistent cloud database & multi-tenant auth)
# Project URL: Found in Supabase Project Settings -> API (e.g. https://your-ref.supabase.co)
SUPABASE_URL=
# Anon / Public Key: Client-safe key for Row-Level Security (RLS) queries
SUPABASE_ANON_KEY=
# Service Role Secret Key: Server-side admin key that bypasses RLS (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL Connection URI: Transaction pooler (port 6543) or direct session (port 5432)
SUPABASE_DATABASE_URL=

# WEBMAIL & HOSTINGER SMTP CREDENTIALS (can also be configured per-tenant in Settings)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
