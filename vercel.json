{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/app/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/app",
      "destination": "/server.ts"
    },
    {
      "source": "/app/(.*)",
      "destination": "/server.ts"
    }
  ]
}
