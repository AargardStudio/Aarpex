{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/app/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/app", "destination": "/api" },
    { "source": "/app/(.*)", "destination": "/api" }
  ]
}
